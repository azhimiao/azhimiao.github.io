[Unit]
Description=Nyra static download helper (loopback :8791)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/download.memprism.com
# python3 http.server is enough — product ignores concurrency limits for APK
ExecStart=/usr/bin/python3 -m http.server 8791 --bind 127.0.0.1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
